{
  "embedder": {
    "client_class": "OpenAIClient",
    "initialize_kwargs": {
      "api_key": "dummy-key",
      "base_url": "http://localhost:8002/v1"
    },
    "model_kwargs": {
      "model": "nomic-ai/nomic-embed-text-v1.5",
      "encoding_format": "float"
    },
    "batch_size": 32
  },
  "embedder_ollama": {
    "client_class": "OllamaClient",
    "model_kwargs": {
      "model": "nomic-embed-text"
    }
  },
  "retriever": {
    "top_k": 20
  },
  "text_splitter": {
    "split_by": "token",
    "chunk_size": 350,
    "chunk_overlap": 100
  }
}